{
  "name": "outcome",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["shared", "server", "web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev --workspace=@outcome/server & npm run dev --workspace=@outcome/web",
    "build": "npm run build --workspace=@outcome/shared && npm run build --workspace=@outcome/server && npm run build --workspace=@outcome/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@outcome/server",
    "db:seed": "npm run db:seed --workspace=@outcome/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
