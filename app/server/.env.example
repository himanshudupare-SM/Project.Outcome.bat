# --- core ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:5173

# --- database ---
DATABASE_URL=postgres://outcome:outcome@127.0.0.1:5432/outcome_dev
DATABASE_POOL_MAX=10

# --- security ---
# 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
COOKIE_SECURE=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- ai ---
# fake = deterministic local provider (no network, used by tests)
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_INPUT_CHARS=40000
AI_DAILY_CALL_BUDGET=500

# --- misc ---
LOG_LEVEL=info
EMAIL_PROVIDER=console
